# --- Deployment ---------------------------------------------------------
# Canonical site URL used for metadata, sitemap and social cards.
# Vercel example:        https://england-made-fluent.vercel.app
# GitHub Pages example:  https://<user>.github.io/england-made-fluent
NEXT_PUBLIC_SITE_URL=

# Sub-path the site is served from. Leave empty for Vercel / root domains.
# GitHub Pages project sites need e.g. /england-made-fluent
BASE_PATH=

# --- Analytics (optional, disabled by default) ---------------------------
# Privacy-conscious analytics (Plausible-compatible). No advertising
# trackers are ever loaded. When enabled, a /privacy page is linked from
# the footer. See docs/ANALYTICS.md.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
